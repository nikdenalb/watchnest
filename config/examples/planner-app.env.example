# Example only — copy to ignored `.env.planner-app` and replace placeholders.
# See planner-app/README.md (Build and run).
# Runtime uses this local PostgreSQL URL. :planner-app:test uses Docker Testcontainers, not this URL.

SERVER_PORT=8080
WATCHNEST_FRONTEND_ORIGIN=http://localhost:5173
WATCHNEST_SESSION_COOKIE_SECURE=false

SPRING_PROFILES_ACTIVE=persistent
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/watchnest
SPRING_DATASOURCE_USERNAME=watchnest
SPRING_DATASOURCE_PASSWORD=watchnest-local
