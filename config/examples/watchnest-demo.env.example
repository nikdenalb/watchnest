# Demo / Yandex Cloud Compose — copy to repo-root `.env.demo` (gitignored) and edit.
# Never commit real passwords.
#
# First demo cut: HTTP on the VM public IP (no custom domain required).
# Replace 203.0.113.10 with your VM's public IPv4.

WATCHNEST_SERVER_NAME=203.0.113.10
WATCHNEST_ACME_EMAIL=you@example.com
WATCHNEST_FRONTEND_ORIGIN=http://203.0.113.10
WATCHNEST_SESSION_COOKIE_SECURE=false

POSTGRES_DB=watchnest
POSTGRES_USER=watchnest
POSTGRES_PASSWORD=change-me-to-a-long-secret
