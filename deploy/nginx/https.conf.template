# HTTPS after certbot has issued a cert for WATCHNEST_SERVER_NAME.
server {
    listen 80;
    server_name ${WATCHNEST_SERVER_NAME};
    include /etc/nginx/watchnest-security-headers.conf;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location = /cms {
        return 301 https://$host/cms/;
    }

    location = /cms/api {
        return 301 https://$host/cms/api/;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${WATCHNEST_SERVER_NAME};
    include /etc/nginx/watchnest-security-headers.conf;

    ssl_certificate     /etc/letsencrypt/live/${WATCHNEST_SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${WATCHNEST_SERVER_NAME}/privkey.pem;

    location = /actuator/health {
        proxy_pass http://app:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /actuator {
        return 404;
    }

    location ^~ /actuator/ {
        return 404;
    }

    location /api/ {
        proxy_pass http://app:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    include /etc/nginx/cms-locations.inc;

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }
}
